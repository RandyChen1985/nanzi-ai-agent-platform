# 编辑器统一约定（与 .prettierrc.json / 现有代码风格一致）
#
# 背景：EmbedChat.vue / ChatInput.vue 长期靠人肉维持缩进，同一个文件里 2 空格与 4 空格
# 并存、单双引号混用。没有这份约定时，每个人的编辑器都会按自己的默认值重排，diff 噪音
# 会把真正的改动埋掉。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{py,pyi}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2

[Makefile]
indent_style = tab
