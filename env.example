# =============================================================================
#  NanZi AI Agent Platform · 环境变量模板
# -----------------------------------------------------------------------------
#  用法：cp env.example .env，再按实际部署环境修改各段取值。
#  约定：
#    · 每段以 「# ---- [序号] 段名 ----」 单行横幅分隔，按部署顺序排列；
#    · 键值原样保留，改注释不影响运行；被注释掉的键表示「按需开启」，
#      不取消注释即使用代码内默认值（app/core/config.py）。
#    · 段内标 [必填] 的项缺失会导致启动失败或会话失效，其余为可选/可调项。
# =============================================================================


# ---- [1] 服务基础 -----------------------------------------------------------
# 运行模式：dev（本地开发）/ production（生产）。
# 它只控制一件事——「生产安全模式」：production 时 500/503 响应的 detail 只给中性文案、
# 且不挂载 /api/test/echo 调试端点；其它值会原样回显异常原文（仅适合开发排障）。
# 判定已做归一化（strip + 小写，也认 prod / prd），但请统一写 production，别写 prod。
# 它不影响 CORS、日志级别、OpenAPI 文档或连接的数据库。
API_SERVICE_ENV=dev
# 后端 HTTP 监听端口（容器内端口；宿主机映射由 Compose / K8s 决定）
API_SERVICE_PORT=8001
# 实例 ID：多实例部署时用来区分「这条心跳来自哪个节点」，如 dev-node / api-1 / api-2。
# 留空则回退 hostname（容器里是随机容器 ID，诊断页卡片标题会是一串难读的哈希）。
# 它同时是 Redis 键 nanzi:instance:{id} 的一部分：改它等于换实例身份，旧卡片 45 秒后自然消失。
# ⚠️ 多实例部署时每个节点必须填不同值——同名会写进同一个 Redis 键，心跳互相覆盖，
#    页面上看起来只剩一个节点（且 CPU/内存数字在两台机器之间跳）。
NODE_ID=dev-node
# 后端日志级别：DEBUG / INFO / WARNING / ERROR。
# 提示：app/main.py 的 logging.basicConfig 当前固定 INFO，此键仅用于容器环境对齐，
# 改它暂时不会改变日志量（排查问题前先确认这一点）。
API_SERVICE_LOG_LEVEL=INFO


# ---- [2] 对外访问与跨域 -----------------------------------------------------
# 平台对外访问 Origin（仅填写协议、域名和可选端口，不要填写 /api 或 /mcp 路径）。
# 用于生成钉钉/企微报表简报、生成文件下载链接，以及生成 Platform/Echo MCP 地址。
# 同时用于 MCP Streamable HTTP 的 Host/Origin 白名单校验，避免公网访问出现 421 Invalid Host header。
APP_PUBLIC_URL=https://nanzi.example.com
# CORS 允许的来源。服务端启用了 allow_credentials（浏览器会话凭据），
# 而浏览器不接受通配符 "*" 与凭据共存，跨域部署时请填写实际访问域名：
#   ALLOWED_ORIGINS=["https://console.example.com","https://ops.example.com"]
# 未配置时回退为 ["*"] 并在启动日志中告警（前后端同源部署可忽略）。
ALLOWED_ORIGINS=["*"]


# ---- [3] 会话与任务调度 -----------------------------------------------------
# 门户会话令牌：开启后浏览器只持有不透明随机令牌（sess_...），真实 API Key 不再下发到前端。
# 默认 true。仅在 Redis 不可用等异常场景，才需要临时置 false 回退到旧行为（cookie 直存真实 Key）。
PORTAL_SESSION_TOKEN_ENABLED=true
# 是否在当前节点启动 APScheduler；多节点部署时只在一个节点设为 true
TASK_SCHEDULER_ENABLED=true


# ---- [4] 工作空间 -----------------------------------------------------------
# 工作空间「上传到此目录」的单文件上限（MB），默认 200。
# 服务端按 1MiB 分块流式落盘，内存占用与文件大小无关；调大前请确认磁盘配额，
# 若在反向代理之后部署，还需同步对齐代理的请求体上限（proxy-body-size / client_max_body_size）。
WORKSPACE_UPLOAD_MAX_MB=200
# 解压压缩包上限（压缩炸弹防护，任一超限即中止并回滚本次已写出的文件）：
# 解压后总字节数（MB）与条目数，默认 1024MB / 5000 条。
# WORKSPACE_EXTRACT_MAX_MB=1024
# WORKSPACE_EXTRACT_MAX_ENTRIES=5000


# ---- [5] 主数据库 -----------------------------------------------------------
# 主库类型：mysql（默认）/ postgresql（也接受 postgres、pg）。
# MySQL 迁移用 db-prod/，PostgreSQL 迁移用 db-prod-pg/，两套不可混用。
DATABASE_TYPE=mysql

# MySQL（DATABASE_TYPE=mysql 时必填；user/password 中的 @ : # / 等特殊字符会自动编码）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=nanzi_ai_agent_platform
MYSQL_USER=root
MYSQL_PASSWORD=root123

# PostgreSQL（DATABASE_TYPE=postgresql 时必填）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nanzi_ai_agent_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# 连接池可调项（默认值即可满足大多数部署，出现「池耗尽」类超时再调整）：
# 从池中取连接的最长等待（秒）——不设时 SQLAlchemy 默认 30s，池耗尽会让请求一起排队
# DATABASE_POOL_TIMEOUT=10
# 建立 TCP 连接的超时（秒）
# DATABASE_CONNECT_TIMEOUT=10
# 半开连接靠内核 keepalive 回收（空闲开始探测 / 探测间隔 / 连续失败次数）
# DATABASE_TCP_KEEPALIVE_IDLE=60
# DATABASE_TCP_KEEPALIVE_INTERVAL=10
# DATABASE_TCP_KEEPALIVE_COUNT=3


# ---- [6] Redis --------------------------------------------------------------
# 平台运行强依赖（缓存、限流、门户会话令牌、审计队列）；容器部署时 Host 通常是服务名 redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=root123
REDIS_ENABLE=true

# 审计日志走 Redis 共享队列（多节点一致、崩溃不丢、落库失败可重试）。
# 置 false 回退进程内队列（仅适合单机）；Redis 不可用时也会自动回退，不会丢审计。
# AUDIT_USE_REDIS_QUEUE=true
# MCP 接口限流（每分钟）：按客户端 IP / 按用户
# MCP_RATE_LIMIT_CLIENT_PER_MINUTE=120
# MCP_RATE_LIMIT_USER_PER_MINUTE=60


# ---- [7] 安全与加密 ---------------------------------------------------------
# 用户 API Key 摘要算法
API_SERVICE_API_KEY_HASH_ALGORITHM=sha256
# [必填] 用户 API Key 的对称加密密钥（Fernet，32 字节 url-safe base64）。
# 生成：python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# 注意：轮换该密钥会使已存量的 API Key 无法解密，需重新生成。
ENCRYPTION_KEY=KkJgK_d-1Jda9CAp7iGhRDzuXLYZfnid2siBeIC5lqw=
# 产物下载 token 的签名密钥（可选，未配置时回退 ENCRYPTION_KEY）。
# 轮换它会使所有已分发的下载链接失效。
# ARTIFACT_TOKEN_SECRET=


# ---- [8] SSO 统一认证（非标准，仅作者公司内部门户场景） ---------------------
# 注意：这不是通用 SSO，也不遵循任何标准协议（不是 OAuth2 / OIDC / SAML / CAS），
# 对接的是作者所在公司内部门户（yovole）自建的私有 HTTP 接口 check/login：
#   · 请求字段（REQUEST_SYSTEM / REQUEST_BUSINESS / loginType=local|ad）由对方定义；
#   · 返回结构与「用户列表由同域 /user/list 派生」都是写死的约定，换一个门户大概率对不上；
#   · 认证失败、参数缺失、业务 code 的语义也都按对方实现处理（见 app/services/auth_service.py）。
# 没有这套门户时请整段忽略：把 SSO_LOGIN_AD / SSO_LOGIN_LOCAL 都置 off，
# 登录页的 SSO 入口就会隐藏/置灰，改用平台自带的「本地账号」或「API Key」登录
# （POST /api/portal/auth/login），与 SSO 无关。自带登录无需配置本段任何变量。
# 另：启用 SSO 还需在「系统配置」里打开 yovole_sso_enabled（种子值默认 false，即开箱不启用），
# 否则 /sso/login 直接返回 403，登录页也不会显示 SSO 入口。
#
# 以下为接入该门户时的必填项：
# 用户列表接口由 SSO_API_URL 派生（同域不同 path：/check/login -> /user/list），
# 所以这里必须填绝对地址，写成相对路径启动后会抛 ValueError。
SSO_API_URL=https://yovole.net/api/v1/user/check/login
SSO_ACCESS_TOKEN=laplace
SSO_REQUEST_SYSTEM=NANZI_AI_AGENT_PLATFORM
SSO_REQUEST_BUSINESS=USER-LOGIN
# 单次认证请求超时（秒）；域账号走 LDAP，网络不通时它会一直等到超时才失败
SSO_TIMEOUT=30
# check/login 必传：local（门户本地密码）/ ad（域账号）；这是默认选中项，用户可在登录页切换
SSO_LOGIN_DEFAULT_TYPE=ad
# 登录方式开关（on / off）。off 的那一项在登录页显示「禁用」且不可选，后端也会拒绝；
# 两个都 off = 本部署不提供 SSO 登录，登录页 SSO 区块的输入框和按钮整体禁用
SSO_LOGIN_AD=on
SSO_LOGIN_LOCAL=on


# ---- [9] Jira 集成（可选） --------------------------------------------------
# 其它外部集成不在环境变量里配置：RAGFlow 地址/密钥、默认 LLM 模型与密钥、沙箱镜像源等，
# 统一在「系统配置」页维护（存 system_configs，运行期由 ConfigService 读取）。
#
# Jira：智能体的 Jira 工具按进程环境变量读取这三项，未配置时该工具不可用（不影响平台其它功能）。
# Compose 已显式传入；本地直跑需 export 或由启动脚本注入，仅写 .env 不会被 os.getenv 读到。
JIRA_URL=https://jira.example.com
JIRA_USERNAME=your_username
JIRA_PASSWORD=your_password
