API_SERVICE_ENV=dev
API_SERVICE_PORT=8001
API_SERVICE_LOG_LEVEL=INFO
# 平台对外访问 Origin（仅填写协议、域名和可选端口，不要填写 /api 或 /mcp 路径）。
# 用于生成钉钉/企微报表简报、生成文件下载链接，以及生成 Platform/Echo MCP 地址。
# 同时用于 MCP Streamable HTTP 的 Host/Origin 白名单校验，避免公网访问出现 421 Invalid Host header。
APP_PUBLIC_URL=https://nanzi.example.com
# 是否在当前节点启动 APScheduler；多节点部署时只在一个节点设为 true
TASK_SCHEDULER_ENABLED=true

# Main database type: mysql (default)
DATABASE_TYPE=mysql

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=nanzi_ai_agent_platform
MYSQL_USER=root
MYSQL_PASSWORD=root123

# PostgreSQL (used when DATABASE_TYPE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nanzi_ai_agent_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=root123
REDIS_ENABLE=true

# Security-用户 API Key 的对称加密密钥（Fernet）
API_SERVICE_API_KEY_HASH_ALGORITHM=sha256
ENCRYPTION_KEY=KkJgK_d-1Jda9CAp7iGhRDzuXLYZfnid2siBeIC5lqw=

# SSO Configuration
SSO_API_URL=https://yovole.net/api/v1/user/check/login
SSO_ACCESS_TOKEN=laplace
SSO_REQUEST_SYSTEM=NANZI_AI_AGENT_PLATFORM
SSO_REQUEST_BUSINESS=USER-LOGIN
SSO_TIMEOUT=30

# RAGFlow Config
RAGFLOW_API_KEY=ragflow-xxxxxxxxxxxxxxxxxxxxxxxx
RAGFLOW_HOST=http://ragflow-server:9380

# Jira Integration (Optional)
JIRA_URL=https://jira.example.com
JIRA_USERNAME=your_username
JIRA_PASSWORD=your_password
